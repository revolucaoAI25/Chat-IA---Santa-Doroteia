{
  "name": "santa-doroteia-assistente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/bundle-migrations.ts && tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "busca": "tsx scripts/medir-busca.ts",
    "verify": "tsx scripts/verify-env.ts && tsx scripts/verify-render.tsx && tsx scripts/verify.ts",
    "db:reset": "tsx scripts/reset.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "db:bundle": "tsx scripts/bundle-migrations.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "mammoth": "^1.12.2",
    "next": "^16.3.4",
    "openai": "^7.10.0",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
