# ============================================================================
# Variáveis de ambiente
#
# Para PUBLICAR NA VERCEL, siga o DEPLOY.md — lá o passo a passo diz de onde
# tirar cada valor. Aqui os blocos estão na ordem de importância.
#
# Para RODAR LOCALMENTE, copie este arquivo para .env.local e preencha.
# ============================================================================


# ============================================================================
# 1. OBRIGATÓRIAS — sem estas a aplicação não funciona
# ============================================================================

# Banco da aplicação. No Supabase: botão "Connect" -> aba "Direct Connection
# string" -> marque TRANSACTION POOLER. Termina em :6543.
# A detecção da porta já desliga prepared statements sozinha.
DATABASE_URL=postgresql://postgres.abc:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Banco para as MIGRAÇÕES. Mesma tela, marcando SESSION POOLER. Termina em :5432.
# Precisa ser modo sessão: DDL com vários statements não roda no pooler de
# transações. NÃO use a "Direct connection" — no plano gratuito ela só responde
# por IPv6, e a Vercel não fala IPv6.
DATABASE_URL_DIRECT=postgresql://postgres.abc:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Assinatura do cookie de sessão. Qualquer texto aleatório com 32+ caracteres.
# Gere em https://generate-secret.vercel.app/32
SESSION_SECRET=troque-isto-por-uma-string-aleatoria-de-32-caracteres-ou-mais

# Chave da OpenAI. Sem ela o sistema entra em modo demonstração: as telas
# funcionam, mas não há geração de linguagem nem OCR.
OPENAI_API_KEY=sk-...

# Armazenamento dos arquivos originais (PDFs e logo).
# OBRIGATÓRIAS na Vercel: o disco de lá é somente leitura, e sem isto a
# ingestão falha ao salvar. Localmente podem ficar de fora — os arquivos vão
# para ./storage.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=documentos


# ============================================================================
# 2. INSTALAÇÃO — só no primeiro deploy, e depois REMOVA
#
# A rota /api/setup cria as tabelas e o primeiro administrador. Sem
# SETUP_TOKEN definida, ela responde 404 e deixa de existir — remover a
# variável é o que fecha a porta depois de instalar.
# ============================================================================

# Só letras, números e hífen: este valor vai na URL da chamada de instalação,
# e símbolos como @ # & % podem chegar embaralhados do outro lado.
# SETUP_TOKEN=uma-senha-longa-que-voce-inventa-16-ou-mais
# SETUP_ADMIN_EMAIL=voce@escola.com.br
# SETUP_ADMIN_PASSWORD=senha-do-administrador-8-ou-mais
# SETUP_ADMIN_NAME=Seu Nome
# SETUP_ADMIN_MATRICULA=ADM001
# SETUP_SCHOOL_NAME=Colégio Santa Dorotéia Belo Horizonte - MG


# ============================================================================
# 3. OPCIONAIS — todas já têm padrão no código
#
# Só defina se quiser mudar o padrão. Deixar de fora não causa erro nenhum,
# e criar a variável com o campo EM BRANCO também não: o código trata vazio
# como ausente. Ainda assim, o mais limpo é simplesmente não criá-las.
# ============================================================================

# Modelos. Um por tarefa: a ingestão roda uma vez por documento e um erro ali
# vira dado errado no banco, então usa o modelo maior; o chat roda dezenas de
# milhares de vezes e usa o mini. Trocar o de EMBEDDING exige reindexar o acervo.
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_PLANNER_MODEL=gpt-4.1-mini
# OPENAI_EXTRACTION_MODEL=gpt-4.1
# OPENAI_VISION_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vigência padrão, em meses, quando nem o documento nem o administrador
# definem uma data de expiração.
# DEFAULT_RETENTION_MONTHS=12

# Limite de perguntas por usuário, em janela deslizante.
# CHAT_RATE_WINDOW_MINUTES=10
# CHAT_RATE_MAX_QUESTIONS=20

# Depois de quantas horas sem interação a conversa é encerrada e a próxima
# pergunta começa outra thread.
# CONVERSATION_IDLE_HOURS=24

# O calendário letivo (início do ano, fim das três etapas), o fuso e o contexto
# institucional NÃO ficam aqui: são editados em Administração -> Configurações.
# São conhecimento da secretaria, e corrigi-los não deve exigir um deploy.


# ============================================================================
# 4. SÓ DESENVOLVIMENTO LOCAL — não coloque na Vercel
# ============================================================================

# Senha dos usuários criados por `npm run db:seed`. O seed é um script local;
# em produção os usuários vêm da tela de Administração.
# SEED_PASSWORD=santadoroteia

# Acesso rápido aos perfis de demonstração, SEM SENHA, na tela de login.
# Fora de produção já vem ligado. NÃO defina isto em produção: seria deixar
# qualquer pessoa entrar como administrador.
# ENABLE_DEMO_LOGIN=true
