# ----------------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha os valores.
# ----------------------------------------------------------------------------

# Postgres com a extensão pgvector.
# Supabase → Project Settings → Database → Connection string.
#   * Migrações e seed: use a conexão DIRETA (porta 5432).
#   * Aplicação na Vercel: use o TRANSACTION POOLER (porta 6543) — a detecção
#     da porta já desliga prepared statements automaticamente.
DATABASE_URL=postgresql://postgres:senha@db.xxxxxxxx.supabase.co:5432/postgres

# Assinatura do cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=troque-isto-por-uma-string-aleatoria-de-32-caracteres-ou-mais

# ----------------------------------------------------------------------------
# IA — sem a chave o sistema entra em modo demonstração (busca literal, sem
# geração de linguagem e sem OCR). As telas funcionam; a qualidade, não.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Padrões escolhidos por custo-benefício. Todos podem ser trocados sem mexer
# no código; trocar o modelo de EMBEDDING exige reindexar o acervo.
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EXTRACTION_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ----------------------------------------------------------------------------
# Armazenamento dos arquivos originais.
# Sem estas variáveis os arquivos vão para ./storage no disco local — bom para
# desenvolvimento, inviável na Vercel (sistema de arquivos somente leitura).
# ----------------------------------------------------------------------------
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=documentos

# Vigência padrão, em meses, quando nem o documento nem o administrador
# definem uma data de expiração.
DEFAULT_RETENTION_MONTHS=12

# Senha dos usuários criados pelo seed (apenas para o protótipo).
SEED_PASSWORD=santadoroteia

# Acesso rápido aos perfis de demonstração, SEM SENHA, na tela de login.
# Fora de produção vem ligado por padrão. Em produção só funciona com "true" —
# não defina esta variável no ambiente de produção real.
# ENABLE_DEMO_LOGIN=true

# Modelo do planejador (reescrita de consulta e decisão de esclarecimento).
# Roda a cada pergunta e é tarefa pequena: é o lugar do modelo mais barato.
OPENAI_PLANNER_MODEL=gpt-4.1-mini

# Limite de perguntas por usuário, em janela deslizante.
CHAT_RATE_WINDOW_MINUTES=10
CHAT_RATE_MAX_QUESTIONS=20

# ----------------------------------------------------------------------------
# Calendário acadêmico
# O colégio divide o ano letivo em três etapas (trimestres). Estas datas são um
# palpite razoável e DEVEM ser confirmadas com a secretaria — elas definem qual
# etapa a IA considera vigente ao responder.
# ----------------------------------------------------------------------------
# Fim de cada etapa, em MM-DD, na ordem 1ª, 2ª, 3ª:
ACADEMIC_ETAPA_ENDS=05-15,08-31,12-20
# Início do ano letivo, em MM-DD:
ACADEMIC_YEAR_START=02-01
# Fuso do colégio: fixado porque o servidor roda em UTC na Vercel, e uma prova
# às 7h10 não pode virar "ontem" por causa disso.
SCHOOL_TIMEZONE=America/Sao_Paulo
